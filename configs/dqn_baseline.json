{
  "experiment_name": "dqn_baseline",
  "agent": "dqn",
  "seed": 42,
  
  "environment": {
    "num_nodes": 15,
    "branching_factor": 2.0,
    "max_depth": 7,
    "popup_probability": 0.15,
    "num_dependencies": 2,
    "max_steps": 100
  },
  
  "training": {
    "num_episodes": 1000,
    "max_steps_per_episode": 100,
    "learning_rate": 0.001,
    "discount_factor": 0.99,
    "batch_size": 32,
    "eval_frequency": 100,
    "num_eval_episodes": 10,
    "checkpoint_frequency": 500,
    "log_frequency": 10
  },
  
  "agent_config": {
    "epsilon": 1.0,
    "epsilon_decay": 0.995,
    "epsilon_min": 0.01,
    "buffer_size": 10000,
    "target_update_frequency": 100,
    "hidden_dims": [128, 128]
  }
}
