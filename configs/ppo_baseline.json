{
  "experiment_name": "ppo_baseline",
  "agent": "ppo",
  "seed": 42,
  
  "environment": {
    "num_nodes": 15,
    "branching_factor": 2.0,
    "max_depth": 7,
    "popup_probability": 0.15,
    "num_dependencies": 2,
    "max_steps": 100
  },
  
  "training": {
    "num_episodes": 1000,
    "max_steps_per_episode": 100,
    "learning_rate": 0.0003,
    "discount_factor": 0.99,
    "batch_size": 64,
    "eval_frequency": 100,
    "num_eval_episodes": 10,
    "checkpoint_frequency": 500,
    "log_frequency": 10
  },
  
  "agent_config": {
    "gae_lambda": 0.95,
    "clip_epsilon": 0.2,
    "entropy_coef": 0.01,
    "value_coef": 0.5,
    "max_grad_norm": 0.5,
    "hidden_dims": [128, 128],
    "ppo_epochs": 4
  }
}
